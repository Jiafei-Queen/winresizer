# Refuse to install package versions published less than 7 days (10080 minutes)
# ago, reducing exposure to freshly compromised or malicious releases.
# npm 12 calls this `min-release-age`; the pnpm/bun spelling
# (`minimum-release-age`) is unknown to npm and only warns. Locked versions
# are unaffected; a fresh resolution inside the window fails the install
# unless excluded via `min-release-age-exclude`.
min-release-age=10080
